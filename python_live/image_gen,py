from dotenv import load_dotenv
from openai import OpenAi
import base64
from pathlib import Path
from langchain_openai import ChatOpenAI
from langchain_core.prompts import ChatPromptTemplate
from langchain_core.output_parsers import StrOuptutParser

load_dotenv()

client = OpenAI()

HERE = Path(__file__).parent

def save(result, filename):
    path = HERE /filename

    path.write_bytes(
        base64.b64decode(result.data[0].b64_json)
    )
    
write = {
    ChatPromptTemplate.from_message([
        {
            "system",
            "You write smart, visual image prompts, one sentences"
        },
        {
            "human",
            "An illustations for a blog post {topic}"
        }
    ])
    | ChatOpenAI(model="gpt-4o-mini")
    | StrOuptutParser()
}

image_prompt = write.invoke({
    "topic": "Learning Langchain"
})

print("Output: ", image_prompt)

result = client.images.generate(
            model="gpt-image-1-mini",
            prompt=image_prompt,
            size="1024x1024",
            quality="low"
        )

save(result, "generated_from_chain.png")